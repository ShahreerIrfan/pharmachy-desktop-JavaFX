<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- JavaFX 21 | Login Gate | stylesheet is resolved relative to this FXML file. -->
<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pharmacy.pos.controllers.LoginGateController"
      stylesheets="@login-gate.css"
      styleClass="terminal-split-root"
      prefWidth="1280.0" prefHeight="800.0"
      minWidth="1080.0" minHeight="760.0">

    <!-- LEFT: brand, context and terminal information -->
    <VBox styleClass="hero-column" prefWidth="406.0" minWidth="406.0" maxWidth="406.0">
        <padding>
            <Insets top="32.0" right="30.0" bottom="25.0" left="34.0"/>
        </padding>

        <!-- Compact brand lockup -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <StackPane styleClass="hero-logo" minWidth="42.0" minHeight="42.0">
                <Label text="+" styleClass="hero-logo-mark"/>
            </StackPane>
            <VBox spacing="2.0" alignment="CENTER_LEFT">
                <Label text="BANGLADESH PHARMACY" styleClass="hero-brand-name"/>
                <Label text="ERP &amp; POS SYSTEM" styleClass="hero-brand-line"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="PRO" styleClass="hero-brand-pill"/>
        </HBox>

        <!-- Product value proposition -->
        <VBox spacing="10.0">
            <VBox.margin>
                <Insets top="31.0"/>
            </VBox.margin>
            <Label text="COUNTER WORKSPACE / 01" styleClass="hero-eyebrow"/>
            <Label text="Your pharmacy.&#10;Ready for business." styleClass="hero-app-title" wrapText="true"/>
            <Label text="A secure, focused workspace for the people behind every prescription and sale."
                   styleClass="hero-app-subtitle" wrapText="true"/>
        </VBox>

        <!-- Clock -->
        <VBox styleClass="hero-info-card,hero-clock-card" spacing="3.0">
            <VBox.margin>
                <Insets top="24.0"/>
            </VBox.margin>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Region styleClass="hero-online-dot"/>
                <Label text="TERMINAL LOCAL TIME" styleClass="hero-card-header"/>
            </HBox>
            <Label fx:id="liveClockLabel" text="--:--" styleClass="hero-clock-large"/>
            <Label fx:id="liveDateLabel" text="Synchronizing terminal date..." styleClass="hero-date-text"/>
        </VBox>

        <!-- Hardware and seat profile -->
        <VBox styleClass="hero-info-card" spacing="12.0">
            <VBox.margin>
                <Insets top="15.0"/>
            </VBox.margin>
            <Label text="REGISTER INFORMATION" styleClass="hero-card-header"/>
            <HBox alignment="CENTER_LEFT">
                <Label text="Branch" styleClass="hero-info-row-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Dhanmondi Central" styleClass="hero-info-row-value"/>
            </HBox>
            <HBox alignment="CENTER_LEFT">
                <Label text="Terminal" styleClass="hero-info-row-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="POS-TER-001 · Seat 01" styleClass="hero-info-row-value"/>
            </HBox>
            <HBox alignment="CENTER_LEFT">
                <Label text="Connection" styleClass="hero-info-row-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER_RIGHT" spacing="6.0">
                    <Region styleClass="connection-dot"/>
                    <Label fx:id="authorityStatusLabel" text="Cloud Online" styleClass="hero-connection-status"/>
                </HBox>
            </HBox>
            <HBox alignment="CENTER_LEFT">
                <Label text="DGDA PMS license" styleClass="hero-info-row-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="DGDA-PMS-DH-84920" styleClass="hero-info-row-value"/>
            </HBox>
        </VBox>

        <!-- Shortcuts: reference legend only; handlers remain in controller -->
        <VBox styleClass="hero-info-card,hero-shortcuts-card" spacing="9.0">
            <VBox.margin>
                <Insets top="15.0"/>
            </VBox.margin>
            <Label text="KEYBOARD SHORTCUTS" styleClass="hero-card-header"/>
            <HBox alignment="CENTER_LEFT" spacing="7.0">
                <Label text="NUM" styleClass="hero-shortcut-badge"/>
                <Label text="PIN" styleClass="hero-shortcut-label"/>
                <Label text="ENTER" styleClass="hero-shortcut-badge"/>
                <Label text="Unlock" styleClass="hero-shortcut-label"/>
                <Label text="ESC" styleClass="hero-shortcut-badge"/>
                <Label text="Clear" styleClass="hero-shortcut-label"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="7.0">
                <Label text="F1" styleClass="hero-shortcut-badge"/>
                <Label text="Helpdesk" styleClass="hero-shortcut-label"/>
                <Label text="F5" styleClass="hero-shortcut-badge"/>
                <Label text="Sync catalog" styleClass="hero-shortcut-label"/>
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>
        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="hero-footer">
            <Label text="●" styleClass="hero-footer-symbol"/>
            <Label text="AUTHORIZED STAFF ONLY  ·  v2.0 PRO" styleClass="hero-compliance-text"/>
        </HBox>
    </VBox>

    <!-- RIGHT: fast, touch-friendly counter access -->
    <VBox styleClass="touch-terminal-column" alignment="TOP_CENTER" HBox.hgrow="ALWAYS">
        <padding>
            <Insets top="28.0" right="49.0" bottom="20.0" left="49.0"/>
        </padding>

        <VBox maxWidth="760.0" alignment="TOP_CENTER" VBox.vgrow="ALWAYS">
            <!-- Header / locale -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" maxWidth="760.0">
                <VBox alignment="CENTER_LEFT" spacing="5.0">
                    <Label text="STAFF AUTHENTICATION" styleClass="terminal-eyebrow"/>
                    <Label fx:id="screenHeadingLabel" text="Unlock your register" styleClass="terminal-header-title"/>
                    <Label fx:id="screenSubheadingLabel"
                           text="Select your profile and enter your four-digit security PIN."
                           styleClass="terminal-header-subtitle" wrapText="true"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox styleClass="lang-toggle-container" alignment="CENTER" spacing="3.0">
                    <Button fx:id="langEnBtn" text="English"
                            styleClass="lang-toggle-btn,lang-toggle-btn-active"
                            onAction="#handleSwitchLangEn"/>
                    <Button fx:id="langBnBtn" text="বাংলা"
                            styleClass="lang-toggle-btn" onAction="#handleSwitchLangBn"/>
                </HBox>
            </HBox>

            <!-- Staff selection -->
            <HBox alignment="CENTER_LEFT" maxWidth="760.0">
                <VBox.margin>
                    <Insets top="22.0" bottom="10.0"/>
                </VBox.margin>
                <Label fx:id="selectStaffLabel" text="01  /  CHOOSE A STAFF PROFILE" styleClass="section-heading"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="3 PROFILES" styleClass="section-count-pill"/>
            </HBox>

            <HBox spacing="12.0" alignment="CENTER" maxWidth="760.0">
                <HBox fx:id="cardCashier" styleClass="staff-tile,staff-tile-active"
                      alignment="CENTER_LEFT" spacing="10.0" HBox.hgrow="ALWAYS"
                      onMouseClicked="#handleSelectCashier" focusTraversable="true">
                    <StackPane styleClass="avatar-circle" minWidth="43.0" minHeight="43.0">
                        <Label text="TA" styleClass="avatar-initials"/>
                    </StackPane>
                    <VBox spacing="4.0" alignment="CENTER_LEFT">
                        <Label text="Tanvir Ahmed" styleClass="staff-tile-name"/>
                        <Label text="Senior Cashier" styleClass="staff-tile-role"/>
                    </VBox>
                </HBox>

                <HBox fx:id="cardPharmacist" styleClass="staff-tile"
                      alignment="CENTER_LEFT" spacing="10.0" HBox.hgrow="ALWAYS"
                      onMouseClicked="#handleSelectPharmacist" focusTraversable="true">
                    <StackPane styleClass="avatar-circle,avatar-mint" minWidth="43.0" minHeight="43.0">
                        <Label text="FH" styleClass="avatar-initials,avatar-initials-mint"/>
                    </StackPane>
                    <VBox spacing="4.0" alignment="CENTER_LEFT">
                        <Label text="Dr. Fahim Hasan" styleClass="staff-tile-name"/>
                        <Label text="A-Grade Pharmacist" styleClass="staff-tile-role"/>
                    </VBox>
                </HBox>

                <HBox fx:id="cardManager" styleClass="staff-tile"
                      alignment="CENTER_LEFT" spacing="10.0" HBox.hgrow="ALWAYS"
                      onMouseClicked="#handleSelectManager" focusTraversable="true">
                    <StackPane styleClass="avatar-circle,avatar-violet" minWidth="43.0" minHeight="43.0">
                        <Label text="RI" styleClass="avatar-initials,avatar-initials-violet"/>
                    </StackPane>
                    <VBox spacing="4.0" alignment="CENTER_LEFT">
                        <Label text="Rafiqul Islam" styleClass="staff-tile-name"/>
                        <Label text="Branch Manager" styleClass="staff-tile-role"/>
                    </VBox>
                </HBox>
            </HBox>

            <!-- PIN entry indicator: start empty, never show a hard-coded real PIN -->
            <VBox styleClass="pin-entry-panel" alignment="CENTER" spacing="8.0" maxWidth="760.0">
                <VBox.margin>
                    <Insets top="14.0"/>
                </VBox.margin>
                <Label text="02  /  ENTER YOUR PIN" styleClass="pin-section-heading"/>
                <Label fx:id="selectedStaffNameLabel"
                       text="Signing in as Tanvir Ahmed · Cashier"
                       styleClass="selected-staff-name"/>
                <HBox fx:id="pinDotsBox" styleClass="pin-display-card"
                      alignment="CENTER" spacing="16.0" maxWidth="210.0">
                    <Region fx:id="dot1" styleClass="pin-dot"/>
                    <Region fx:id="dot2" styleClass="pin-dot"/>
                    <Region fx:id="dot3" styleClass="pin-dot"/>
                    <Region fx:id="dot4" styleClass="pin-dot"/>
                </HBox>
            </VBox>

            <!-- Responsive touch keypad. Button onAction IDs match the existing controller. -->
            <GridPane styleClass="numpad-grid" alignment="CENTER" hgap="9.0" vgap="8.0"
                      maxWidth="282.0" prefWidth="282.0">
                <VBox.margin>
                    <Insets top="12.0"/>
                </VBox.margin>
                <Button text="1" styleClass="numpad-key" GridPane.columnIndex="0" GridPane.rowIndex="0" onAction="#handleNumKey"/>
                <Button text="2" styleClass="numpad-key" GridPane.columnIndex="1" GridPane.rowIndex="0" onAction="#handleNumKey"/>
                <Button text="3" styleClass="numpad-key" GridPane.columnIndex="2" GridPane.rowIndex="0" onAction="#handleNumKey"/>
                <Button text="4" styleClass="numpad-key" GridPane.columnIndex="0" GridPane.rowIndex="1" onAction="#handleNumKey"/>
                <Button text="5" styleClass="numpad-key" GridPane.columnIndex="1" GridPane.rowIndex="1" onAction="#handleNumKey"/>
                <Button text="6" styleClass="numpad-key" GridPane.columnIndex="2" GridPane.rowIndex="1" onAction="#handleNumKey"/>
                <Button text="7" styleClass="numpad-key" GridPane.columnIndex="0" GridPane.rowIndex="2" onAction="#handleNumKey"/>
                <Button text="8" styleClass="numpad-key" GridPane.columnIndex="1" GridPane.rowIndex="2" onAction="#handleNumKey"/>
                <Button text="9" styleClass="numpad-key" GridPane.columnIndex="2" GridPane.rowIndex="2" onAction="#handleNumKey"/>
                <Button text="Clear" styleClass="numpad-key,numpad-key-action" GridPane.columnIndex="0" GridPane.rowIndex="3" onAction="#handleClearPin"/>
                <Button text="0" styleClass="numpad-key" GridPane.columnIndex="1" GridPane.rowIndex="3" onAction="#handleNumKey"/>
                <Button text="Del" styleClass="numpad-key,numpad-key-action" GridPane.columnIndex="2" GridPane.rowIndex="3" onAction="#handleBackspacePin"/>
            </GridPane>

            <!-- Live session metadata -->
            <HBox spacing="8.0" alignment="CENTER" maxWidth="760.0">
                <VBox.margin>
                    <Insets top="15.0"/>
                </VBox.margin>
                <Label fx:id="shiftInfoPill" text="Morning shift  ·  08:00–16:00" styleClass="shift-meta-pill"/>
                <Label fx:id="floatInfoPill" text="Opening float  ·  BDT 1,000" styleClass="shift-meta-pill"/>
                <Button fx:id="offlineModeToggleBtn" text="Offline mode: OFF"
                        styleClass="shift-meta-pill,offline-toggle" onAction="#handleToggleOfflineMode"/>
            </HBox>

            <Label fx:id="statusMessageLabel" text="Enter your four-digit PIN to continue."
                   styleClass="status-message" alignment="CENTER" maxWidth="620.0" wrapText="true">
                <VBox.margin>
                    <Insets top="12.0" bottom="10.0"/>
                </VBox.margin>
            </Label>

            <Button fx:id="unlockBtn" text="UNLOCK COUNTER &amp; START SHIFT"
                    styleClass="btn-unlock-large" defaultButton="true"
                    maxWidth="430.0" prefWidth="430.0"
                    onAction="#handleUnlockCounter"/>

            <HBox alignment="CENTER" spacing="6.0" styleClass="terminal-bottom-note">
                <VBox.margin>
                    <Insets top="12.0"/>
                </VBox.margin>
                <Label text="●" styleClass="terminal-note-dot"/>
                <Label text="Staff-only access" styleClass="terminal-note-text"/>
                <Label text="·" styleClass="terminal-note-text"/>
                <Label text="Press F1 for help" styleClass="terminal-note-text"/>
            </HBox>
        </VBox>
    </VBox>
</HBox>
